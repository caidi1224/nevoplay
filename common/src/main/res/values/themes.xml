<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The host is a fullscreen video surface: a black window background keeps the light theme
         from flashing through while the vehicle resizes or animates its system bars. -->
    <style name="Theme.Xcertplay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>

        <!-- Declared in the theme as well as applied at runtime: an OEM SystemUI such as 启源OS 2.2
             may build the window with the theme's bar values and ignore later changes, and a light
             parent theme is what makes the forced status bar grey in the first place. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- Light icons, because the bars above are black. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>